# Copy to backend/.env. Every value is optional for local development.

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Default is a SQLite file at backend/app.db. For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://app:app_local_only@127.0.0.1:5432/orders

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Defaults to on, except in production.
# DOCS_ENABLED=true
